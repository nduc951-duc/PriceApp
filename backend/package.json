{
  "name": "@price-app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx src/server.ts",
    "dev:watch": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "dev:worker": "node --env-file-if-exists=.env.local --import tsx src/rag-worker.ts",
    "request:rag-reindex": "node --env-file-if-exists=.env.local --import tsx src/request-rag-reindex.ts",
    "eval:rag": "node --import tsx src/rag/evaluation-runner.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "start:worker": "node --env-file-if-exists=.env.local dist/rag-worker.js",
    "start:request:rag-reindex": "node --env-file-if-exists=.env.local dist/request-rag-reindex.js",
    "build": "tsc -p tsconfig.json",
    "openapi:generate": "tsx scripts/generate-contract.ts",
    "api:types": "tsx scripts/generate-contract.ts",
    "openapi:check": "tsx scripts/generate-contract.ts --check",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "fastify": "^5.6.0",
    "zod": "^4.4.3"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@types/node": "^20",
    "@eslint/js": "^9",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
