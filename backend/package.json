{
  "name": "@price-app/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server.ts",
    "start": "node --env-file=.env.local dist/server.js",
    "build": "tsc -p tsconfig.json",
    "openapi:generate": "tsx scripts/generate-contract.ts",
    "api:types": "tsx scripts/generate-contract.ts",
    "openapi:check": "tsx scripts/generate-contract.ts --check",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "fastify": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@eslint/js": "^9",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
