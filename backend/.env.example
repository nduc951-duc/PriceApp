API_PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CUSTOMER_ORDER_HMAC_SECRET=replace-with-at-least-32-random-characters

# Server-only credentials for the dedicated Supabase Auth user registered as
# rag_index_worker. Configure both only on the separately deployed worker.
RAG_WORKER_EMAIL=
RAG_WORKER_PASSWORD=

# RAG provider configuration stays on the backend.
RAG_AI_PROVIDER=ollama
RAG_AI_BASE_URL=http://localhost:11434
RAG_AI_API_KEY=
RAG_EMBEDDING_MODEL=bge-m3
# Required for OpenAI-compatible providers. Ollama reads the model digest from /api/tags.
RAG_EMBEDDING_ARTIFACT=
RAG_CHAT_MODEL=qwen2.5:3b
# Keep local models loaded briefly to avoid repeated cold-start latency.
RAG_OLLAMA_KEEP_ALIVE=15m
RAG_OCR_MODEL=glm-ocr
