API_PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
CUSTOMER_ORDER_HMAC_SECRET=replace-with-at-least-32-random-characters
RAG_FEEDBACK_HMAC_SECRET=replace-with-a-different-32-character-random-secret

# Server-only credentials for the dedicated Supabase Auth user registered as
# rag_index_worker. Configure both only on the separately deployed worker.
RAG_WORKER_EMAIL=
RAG_WORKER_PASSWORD=

# Legacy defaults remain supported; per-purpose settings below take precedence.
RAG_AI_PROVIDER=ollama
RAG_AI_BASE_URL=http://localhost:11434
RAG_AI_API_KEY=

# Primary local Ollama chat. Install this model with ollama pull qwen3:4b.
RAG_QUERY_MODE=retrieval_first
RAG_CHAT_PROVIDER=ollama
RAG_CHAT_BASE_URL=http://127.0.0.1:11434
RAG_CHAT_API_KEY=
RAG_CHAT_MODEL=qwen3:4b
# Limit expanded variants to fit a local model context; partial coverage is shown.
RAG_CONTEXT_MAX_VARIANTS=16

# Optional Groq fallback for retrieval_first chat on 429/5xx/network/timeout.
# Use a Groq key here; the local Ollama endpoint needs no API key.
RAG_CHAT_FALLBACK_PROVIDER=groq
RAG_CHAT_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
RAG_CHAT_FALLBACK_API_KEY=
RAG_CHAT_FALLBACK_MODEL=openai/gpt-oss-120b

# Cloud embeddings keep GPU memory available for the local chat model.
# Use a Google AI Studio key in RAG_EMBEDDING_API_KEY.
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Required for OpenAI-compatible providers. Ollama reads the model digest from /api/tags.
RAG_EMBEDDING_ARTIFACT=gemini-embedding-001:1024:l2-v1
# Keep the chat model warm between questions; this does not load an embedding model.
RAG_OLLAMA_KEEP_ALIVE=15m
