{
  "name": "price-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test:dev-runner": "node --test scripts/dev.test.mjs",
    "openapi:generate": "npm run openapi:generate --workspace backend",
    "api:types": "npm run api:types --workspace backend",
    "openapi:check": "npm run openapi:check --workspace backend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace frontend",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:dev-runner && npm test --workspaces",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run openapi:check && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
