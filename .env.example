NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# RAG: local Ollama by default; the Next.js server calls the embedding and chat models.
RAG_AI_PROVIDER=ollama
RAG_AI_BASE_URL=http://localhost:11434
RAG_AI_API_KEY=
RAG_EMBEDDING_MODEL=bge-m3
# Required for openai-compatible providers: immutable model/version identifier.
# Ollama reads the model digest from /api/tags instead.
RAG_EMBEDDING_ARTIFACT=
RAG_CHAT_MODEL=qwen2.5:3b
